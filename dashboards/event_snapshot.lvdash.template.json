        {
          "position": {
            "x": 0,
            "y": 5,
            "width": 3,
            "height": 5
          },
          "widget": {
            "name": "tickets_by_city",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_metrics",
                  "disaggregated": false,
                  "fields": [
                    {
                      "name": "city",
                      "expression": "`city`"
                    },
                    {
                      "name": "sum(confirmed_tickets)",
                      "expression": "SUM(`confirmed_tickets`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "city",
                  "displayName": "City",
                  "scale": {
                    "type": "categorical",
                    "sort": {
                      "by": "y-reversed"
                    }
                  },
                  "axis": {
                    "title": "City"
                  }
                },
                "y": {
                  "fieldName": "sum(confirmed_tickets)",
                  "displayName": "Confirmed tickets",
                  "scale": {
                    "type": "quantitative"
                  },
                  "axis": {
                    "title": "Confirmed tickets"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Confirmed tickets by city"
              }
            }
          }
        },
        {
          "position": {
            "x": 3,
            "y": 5,
            "width": 3,
            "height": 5
          },
          "widget": {
            "name": "tickets_by_month",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "event_metrics",
                  "disaggregated": false,
                  "fields": [
                    {
                      "name": "monthly(event_date)",
                      "expression": "DATE_TRUNC(\"MONTH\", `event_date`)"
                    },
                    {
                      "name": "sum(confirmed_tickets)",
                      "expression": "SUM(`confirmed_tickets`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "bar",
              "encodings": {
                "x": {
                  "fieldName": "monthly(event_date)",
                  "displayName": "Event month",
                  "scale": {
                    "type": "temporal"
                  },
                  "axis": {
                    "title": "Event month"
                  }
                },
                "y": {
                  "fieldName": "sum(confirmed_tickets)",
                  "displayName": "Confirmed tickets",
                  "scale": {
                    "type": "quantitative"
                  },
                  "axis": {
                    "title": "Confirmed tickets"
                  }
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Confirmed tickets by event month"
              }
            }
          }
        },
