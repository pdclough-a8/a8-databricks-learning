      "layout": [
        {
          "position": {
            "x": 0,
            "y": 0,
            "width": 6,
            "height": 2
          },
          "widget": {
            "name": "heading",
            "textbox_spec": "# A8 | Event snapshot\nSynthetic data as at 20 November 2026. Confirmed tickets are not attendees. Ratings represent respondents only. Filters are not security."
          }
        },
        {
          "position": {
            "x": 0,
            "y": 2,
            "width": 2,
            "height": 1
          },
          "widget": {
            "name": "filter_city",
            "queries": [
              {
                "name": "filter_city_query",
                "query": {
                  "datasetName": "event_metrics",
                  "disaggregated": false,
                  "fields": [
                    {
                      "name": "city",
                      "expression": "`city`"
                    },
                    {
                      "name": "city_associativity",
                      "expression": "COUNT_IF(`associative_filter_predicate_group`)"
                    }
                  ]
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "filter-single-select",
              "encodings": {
                "fields": [
                  {
                    "fieldName": "city",
                    "displayName": "city",
                    "queryName": "filter_city_query"
                  }
                ]
              },
              "frame": {
                "showTitle": true,
                "title": "City"
              }
            }
          }
        },
